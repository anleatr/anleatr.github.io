---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import type { MarkdownHeading } from 'astro';
import TableOfContents from '../components/TableOfContents.astro';

type Props = CollectionEntry<'blog'>['data'] & { headings: MarkdownHeading[] };
const { title, description, pubDate, updatedDate, headings } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
	<head><BaseHead title={`${title} · Asera`} description={description} /></head>
	<body>
		<Header />
		<main class="shell page-grid article-grid" class:list={{ 'has-toc': headings.length > 0 }}>
			<article class="card article">
				<header class="article-header">
					<a class="back" href="/blog">← Blog</a>
					<h1>{title}</h1>
					<p class="description">{description}</p>
					<div class="date">
						<FormattedDate date={pubDate} />
						{updatedDate && <span> · Updated <FormattedDate date={updatedDate} /></span>}
					</div>
				</header>
				<div class="prose"><slot /></div>
			</article>
			{headings.length > 0 && <TableOfContents headings={headings} />}
		</main>
	</body>
</html>

<style>
	.article-grid { grid-template-columns: minmax(0, 1fr); }
	.article-header { margin-bottom: 1.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--line); }
	.back { color: var(--accent-soft); font-size: 0.85rem; text-decoration: none; }
	.article-header h1 { margin-top: 0.75rem; font-size: clamp(1.6rem, 2.5vw, 2.25rem); letter-spacing: -0.025em; overflow-wrap: anywhere; }
	.description { margin: 0.75rem 0 0; color: var(--muted); font-size: 1rem; }
	.date { margin-top: 0.75rem; color: var(--muted); font-size: 0.82rem; }
	.prose { min-width: 0; }
	.prose :global(:is(h1, h2, h3, h4, h5, h6)[id]) { scroll-margin-top: 140px; }
	@media (min-width: 768px) {
		.article-grid.has-toc { grid-template-columns: minmax(0, 1fr) var(--sidebar-width); }
	}
</style>
