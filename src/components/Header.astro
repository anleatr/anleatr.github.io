---
import { GITHUB_URL, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a class="identity" href="/" aria-label={`${SITE_TITLE} home`}>
			<span class="mark" aria-hidden="true">A</span>
			<span>{SITE_TITLE}</span>
		</a>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/research">Research</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<a class="github-link" href={GITHUB_URL} target="_blank" rel="noreferrer">GitHub ↗</a>
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 20;
		border-bottom: 1px solid var(--line);
		background: color-mix(in srgb, var(--background) 86%, transparent);
		backdrop-filter: blur(18px);
	}
	nav {
		display: flex;
		width: min(1120px, calc(100% - 2rem));
		min-height: 76px;
		margin: 0 auto;
		align-items: center;
		justify-content: space-between;
	}
	.identity {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		color: var(--text);
		font-family: var(--font-display);
		font-size: 1.05rem;
		font-weight: 700;
		text-decoration: none;
	}
	.mark {
		display: grid;
		width: 2rem;
		height: 2rem;
		place-items: center;
		border: 1px solid var(--accent);
		border-radius: 50%;
		color: var(--accent-soft);
		font-family: var(--font-display);
	}
	.internal-links {
		position: absolute;
		left: 50%;
		display: flex;
		gap: 0.25rem;
		transform: translateX(-50%);
	}
	.github-link {
		color: var(--muted);
		font-size: 0.9rem;
		text-decoration: none;
	}
	.github-link:hover { color: var(--text); }
	@media (max-width: 760px) {
		nav {
			min-height: auto;
			padding: 1rem 0 0.75rem;
			flex-wrap: wrap;
			gap: 0.85rem;
		}
		.internal-links {
			position: static;
			order: 3;
			width: 100%;
			overflow-x: auto;
			transform: none;
			justify-content: center;
		}
	}
</style>
