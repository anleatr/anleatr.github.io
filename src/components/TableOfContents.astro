---
import type { MarkdownHeading } from 'astro';

interface Props { headings: MarkdownHeading[] }
const { headings } = Astro.props;
const minDepth = Math.min(...headings.map((heading) => heading.depth));
let sectionNumber = 0;
const items = headings.map((heading) => ({
	...heading,
	marker: heading.depth === minDepth ? String(++sectionNumber) : '•',
}));
---

<aside class="toc" aria-label="文章目录">
	<div class="toc-title">文章目录</div>
	<button class="toc-toggle" type="button" aria-expanded="false" aria-controls="article-toc-links">文章目录 <span aria-hidden="true">⌄</span></button>
	<nav id="article-toc-links" aria-label="文章章节">
		<ol>
			{items.map((heading) => (
				<li style={`--depth: ${heading.depth - minDepth}`}>
					<a href={`#${heading.slug}`} data-heading-id={heading.slug}>
						<span class="marker" aria-hidden="true">{heading.marker}</span>
						<span>{heading.text}</span>
					</a>
				</li>
			))}
		</ol>
	</nav>
</aside>

<style>
	.toc { order: -1; padding: 1rem; border: 1px solid var(--line); border-radius: var(--card-radius); background: var(--surface); }
	.toc-title { display: none; margin-bottom: 0.75rem; padding-left: 0.75rem; border-left: 3px solid var(--accent); color: var(--text); font-weight: 600; font-size: 1.05rem; }
	.toc-toggle { display: flex; justify-content: space-between; width: 100%; padding: 0; border: 0; background: none; color: var(--text); font: inherit; font-size: 0.9rem; cursor: pointer; }
	nav { display: none; max-height: min(60vh, 32rem); overflow-y: auto; overscroll-behavior: contain; }
	.toc-toggle[aria-expanded="true"] + nav { display: block; margin-top: 0.75rem; }
	ol { list-style: none; margin: 0; padding: 0; }
	li { margin: 0.2rem 0; padding-left: calc(var(--depth) * 0.75rem); }
	a { display: flex; align-items: baseline; gap: 0.5rem; padding: 0.5rem; border-radius: 0.5rem; color: var(--muted); font-size: 0.875rem; line-height: 1.5; text-decoration: none; overflow-wrap: anywhere; }
	.marker { flex: 0 0 1.25rem; text-align: center; color: var(--accent-soft); font-size: 0.8rem; }
	a:hover { color: var(--text); }
	a[aria-current="location"] { color: var(--accent-soft); background: color-mix(in srgb, var(--accent) 12%, transparent); }
	@media (min-width: 768px) {
		.toc { order: 0; position: sticky; top: 92px; }
		.toc-title { display: block; }
		.toc-toggle { display: none; }
		nav { display: block; max-height: calc(100vh - 170px); scrollbar-width: thin; }
	}
</style>

<script>
	document.addEventListener('astro:page-load', () => {
	const toc = document.querySelector<HTMLElement>('.toc');
	if (!toc) return;
	const listeners = new AbortController();
	const toggle = toc.querySelector<HTMLButtonElement>('button')!;
	const nav = toc.querySelector<HTMLElement>('nav')!;
	const links = Array.from(toc.querySelectorAll<HTMLAnchorElement>('a[data-heading-id]'));
	const headings = links.map((link) => document.getElementById(link.dataset.headingId!)!);
	let current = -1;
	let scheduled = false;

	toggle.addEventListener('click', () => {
		toggle.setAttribute('aria-expanded', String(toggle.getAttribute('aria-expanded') !== 'true'));
		requestAnimationFrame(keepCurrentHeadingVisible);
	});

	function keepCurrentHeadingVisible() {
		if (current < 0 || nav.clientHeight === 0) return;
		const item = links[current].getBoundingClientRect();
		const panel = nav.getBoundingClientRect();
		if (item.top >= panel.top && item.bottom <= panel.bottom) return;
		nav.scrollTo({
			top: nav.scrollTop + item.top - panel.top - (nav.clientHeight - item.height) / 2,
			behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth',
		});
	}

	function updateCurrentHeading() {
		scheduled = false;
		let next = 0;
		for (let index = 0; index < headings.length; index++) {
			if (headings[index].getBoundingClientRect().top <= 145) next = index;
			else break;
		}
		if (next === current) return;
		if (current >= 0) links[current].removeAttribute('aria-current');
		links[next].setAttribute('aria-current', 'location');
		current = next;
		keepCurrentHeadingVisible();
	}

	window.addEventListener('scroll', () => {
		if (!scheduled) {
			scheduled = true;
			requestAnimationFrame(updateCurrentHeading);
		}
	}, { passive: true, signal: listeners.signal });
	window.addEventListener('resize', () => {
		updateCurrentHeading();
		keepCurrentHeadingVisible();
	}, { signal: listeners.signal });
	document.addEventListener('astro:before-swap', () => listeners.abort(), { once: true });
	updateCurrentHeading();
	});
</script>
