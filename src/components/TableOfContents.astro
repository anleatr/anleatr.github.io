---
import type { MarkdownHeading } from 'astro';

interface Props { headings: MarkdownHeading[] }
const { headings } = Astro.props;
const minDepth = Math.min(...headings.map((heading) => heading.depth));
const ancestors: number[] = [];
const items = headings.map((heading, index) => {
	while (ancestors.length && headings[ancestors[ancestors.length - 1]].depth >= heading.depth) ancestors.pop();
	const parent = ancestors[ancestors.length - 1] ?? -1;
	ancestors.push(index);
	return { ...heading, parent };
});
---

<aside class="toc" aria-label="文章目录">
	<div class="toc-heading">
		<span>文章目录</span>
		<button class="toc-toggle" type="button" aria-label="展开或收起文章目录" aria-expanded="true" aria-controls="article-toc-links">
			<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
		</button>
	</div>
	<nav id="article-toc-links" aria-label="文章章节">
		<ol>
			{items.map((heading, index) => (
				<li id={`toc-entry-${index}`} data-parent={heading.parent} style={`--depth: ${heading.depth - minDepth}`}>
					{items[index + 1]?.parent === index && (
						<button class="section-toggle" type="button" aria-label={`折叠或展开：${heading.text}`} aria-expanded="true" aria-controls={items.map((item, child) => item.parent === index ? `toc-entry-${child}` : '').filter(Boolean).join(' ')}><span aria-hidden="true">⌄</span></button>
					)}
					<a href={`#${heading.slug}`} data-heading-id={heading.slug}>
						{heading.text}
					</a>
				</li>
			))}
		</ol>
	</nav>
</aside>

<style>
	.toc { display: flex; flex-direction: column; gap: 0.75rem; padding-block: 1rem; }
	.toc-heading { display: flex; flex: none; align-items: center; gap: 0.5rem; color: var(--text); font-size: 0.9rem; font-weight: 600; }
	.toc-toggle {
		display: grid;
		width: 2rem;
		height: 2rem;
		place-items: center;
		padding: 0;
		border: 1px solid var(--line);
		border-radius: 0.7rem;
		background: linear-gradient(180deg, var(--surface-raised), color-mix(in srgb, var(--accent) 14%, var(--surface)));
		box-shadow: 0 2px 4px color-mix(in srgb, var(--accent) 16%, transparent);
		color: var(--accent-soft);
		cursor: pointer;
		transition: transform 180ms cubic-bezier(.2,.7,.4,1.5), border-color 150ms ease;
	}
	.toc-toggle:hover { border-color: var(--accent); }
	.toc-toggle:active { transform: scale(0.88); }
	.toc-toggle:focus-visible { outline: 2px solid var(--accent-soft); outline-offset: 3px; }
	.toc-toggle svg { transition: transform 180ms ease; }
	.toc-toggle[aria-expanded="false"] svg { transform: rotate(-90deg); }
	nav { display: none; max-height: min(60vh, 32rem); overflow-y: auto; overscroll-behavior: contain; scrollbar-color: color-mix(in srgb, var(--muted) 40%, transparent) transparent; }
	.toc-heading:has(.toc-toggle[aria-expanded="true"]) + nav { display: block; }
	ol { list-style: none; margin: 0; padding: 0; }
	li { position: relative; margin: 0.2rem 0; padding-inline-start: calc(0.55rem + var(--depth) * 0.75rem); }
	li::before { position: absolute; inset-block: 0.1rem; inset-inline-start: 0; width: 3px; border-radius: 999px; background: var(--line); pointer-events: none; content: ''; }
	li.is-passed::before { background: var(--accent); }
	li:has(> a[aria-current="location"])::before {
		background: linear-gradient(to bottom, var(--accent-soft) 0 var(--chapter-progress), var(--line) var(--chapter-progress) 100%);
	}
	.section-toggle { position: absolute; right: 0; top: 0.25rem; display: grid; place-items: center; width: 1.75rem; height: 1.75rem; border: 0; border-radius: 0.5rem; background: none; color: var(--muted); font: inherit; cursor: pointer; }
	.section-toggle:hover { background: var(--surface-raised); color: var(--text); }
	.section-toggle[aria-expanded="false"] span { transform: rotate(-90deg); }
	a { display: block; padding: 0.5rem; border-radius: 0.5rem; color: var(--muted); font-size: 0.875rem; line-height: 1.5; text-decoration: none; overflow-wrap: anywhere; }
	li:has(> .section-toggle) > a { padding-right: 1.75rem; }
	a:hover { color: var(--text); }
	a[aria-current="location"] { color: var(--accent-soft); background: color-mix(in srgb, var(--accent) 12%, transparent); }
	@media (min-width: 960px) {
		.toc { min-height: 0; padding-block: 0; }
		.toc-heading { font-size: 1.05rem; }
		nav { min-height: 0; max-height: none; scrollbar-width: thin; }
	}
	@media (prefers-reduced-motion: reduce) {
		.toc-toggle, .toc-toggle svg { transition: none; }
		.toc-toggle:active { transform: none; }
	}
</style>

<script>
	document.addEventListener('astro:page-load', () => {
	const toc = document.querySelector<HTMLElement>('.toc');
	if (!toc) return;
	const listeners = new AbortController();
	const toggle = toc.querySelector<HTMLButtonElement>('.toc-toggle')!;
	const nav = toc.querySelector<HTMLElement>('nav')!;
	const article = toc.closest('main')!.querySelector('article')!;
	const links = Array.from(toc.querySelectorAll<HTMLAnchorElement>('a[data-heading-id]'));
	const headings = links.map((link) => document.getElementById(link.dataset.headingId!)!);
	const entries = Array.from(nav.querySelectorAll<HTMLLIElement>('li'));
	const sectionToggles = entries.map((entry) => entry.querySelector<HTMLButtonElement>('.section-toggle'));
	let current = -1;
	let frame = 0;

	function updateVisibility() {
		entries.forEach((entry) => {
			const parent = Number(entry.dataset.parent);
			entry.hidden = parent >= 0 && (entries[parent].hidden || sectionToggles[parent]!.getAttribute('aria-expanded') === 'false');
		});
	}
	sectionToggles.forEach((button) => button?.addEventListener('click', () => {
		button.setAttribute('aria-expanded', String(button.getAttribute('aria-expanded') !== 'true'));
		updateVisibility();
	}));

	toggle.addEventListener('click', () => {
		toggle.setAttribute('aria-expanded', String(toggle.getAttribute('aria-expanded') !== 'true'));
		requestAnimationFrame(keepCurrentHeadingVisible);
	});

	function keepCurrentHeadingVisible() {
		if (current < 0 || nav.clientHeight === 0 || entries[current].hidden) return;
		const item = links[current].getBoundingClientRect();
		const panel = nav.getBoundingClientRect();
		if (item.top >= panel.top && item.bottom <= panel.bottom) return;
		nav.scrollTo({
			top: nav.scrollTop + item.top - panel.top - (nav.clientHeight - item.height) / 2,
			behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth',
		});
	}

	function updateReadingPosition() {
		frame = 0;
		const articleBottom = article.getBoundingClientRect().bottom;
		const viewport = window.innerHeight;
		const anchor = Math.min(145, viewport);
		const remaining = Math.max(0, articleBottom - viewport);
		// In the last viewport, the reading line moves down to reach the end of the text.
		const finalSweep = Math.min(window.scrollY + remaining, viewport - anchor);
		const line = anchor + (viewport - anchor) * (finalSweep > 0 ? Math.max(0, 1 - remaining / finalSweep) : 0);

		let next = 0;
		let start = headings[0].getBoundingClientRect().top;
		let end = articleBottom;
		for (let index = 1; index < headings.length; index++) {
			const top = headings[index].getBoundingClientRect().top;
			if (top > line) {
				end = top;
				break;
			}
			next = index;
			start = top;
		}
		const fraction = end > start ? Math.min(1, Math.max(0, (line - start) / (end - start))) : 0;
		entries[next].style.setProperty('--chapter-progress', `${100 * fraction}%`);
		if (next === current) return;
		if (current >= 0) links[current].removeAttribute('aria-current');
		links[next].setAttribute('aria-current', 'location');
		entries.forEach((entry, index) => entry.classList.toggle('is-passed', index < next));
		current = next;
		for (let parent = Number(entries[current].dataset.parent); parent >= 0; parent = Number(entries[parent].dataset.parent)) {
			sectionToggles[parent]!.setAttribute('aria-expanded', 'true');
		}
		updateVisibility();
		keepCurrentHeadingVisible();
	}

	function scheduleUpdate() {
		if (!frame) frame = requestAnimationFrame(updateReadingPosition);
	}
	window.addEventListener('scroll', scheduleUpdate, { passive: true, signal: listeners.signal });
	window.addEventListener('resize', scheduleUpdate, { signal: listeners.signal });
	const resizeObserver = new ResizeObserver(() => {
		scheduleUpdate();
		keepCurrentHeadingVisible();
	});
	resizeObserver.observe(article);
	resizeObserver.observe(nav);
	document.addEventListener('astro:before-swap', () => {
		listeners.abort();
		resizeObserver.disconnect();
		cancelAnimationFrame(frame);
	}, { once: true });
	updateReadingPosition();
	});
</script>
