---
import { Image } from 'astro:assets';
import Avatar from '../assets/avatar.jpg';
import { GITHUB_URL } from '../consts';
---

<aside class="profile-sidebar" aria-label="个人信息">
	<div class="profile-card">
		<Image src={Avatar} alt="Asera 的头像" width={512} height={512} />
		<p class="name">Asera</p>
		<p class="greeting">Hi, I’m Asera.</p>
		<a href={GITHUB_URL} target="_blank" rel="noreferrer">GitHub ↗</a>
	</div>
</aside>

<style>
	.profile-card { padding: 1.5rem 1rem; text-align: center; background: var(--surface); border: 1px solid var(--line); border-radius: var(--card-radius); }
	img { width: 144px; aspect-ratio: 1; object-fit: cover; border-radius: 50%; margin: 0 auto 1rem; }
	.name { margin-bottom: 0.25rem; color: var(--text); font-size: 1.25rem; font-weight: 600; }
	.greeting { margin-bottom: 1rem; color: var(--muted); font-size: 0.9rem; }
	a { color: var(--accent-soft); text-decoration: none; font-size: 0.85rem; }
</style>
