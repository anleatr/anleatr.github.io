---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Avatar from '../assets/avatar.jpg';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="zh-CN">
	<head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /></head>
	<body>
		<Header />
		<main>
			<section class="hero shell">
				<div class="portrait">
					<Image src={Avatar} alt="Asera" width={512} height={512} loading="eager" />
					<!-- <p>Asera</p> -->
				</div>
				<div class="introduction">
					<h1>Hi, I’m Asera.</h1>
				</div>
			</section>

			<section class="latest shell">
				<div class="section-heading">
					<h2>Latest writing</h2>
					<a class="text-link" href="/blog">All posts →</a>
				</div>
				<ul class="post-list">
					{posts.map((post) => (
						<li class="post-item">
							<a href={`/blog/${post.id}/`}>
								<div><h3>{post.data.title}</h3><p>{post.data.description}</p></div>
								<time datetime={post.data.pubDate.toISOString()}><FormattedDate date={post.data.pubDate} /></time>
							</a>
						</li>
					))}
				</ul>
			</section>

		</main>
	</body>
</html>

<style>
	.hero { display: grid; min-height: 620px; padding: 6rem 0; grid-template-columns: 3fr 7fr; gap: clamp(3rem, 8vw, 7rem); align-items: center; }
	.portrait { width: min(100%, 220px); justify-self: center; }
	.portrait img { display: block; width: 100%; aspect-ratio: 1; border: 1px solid var(--line); border-radius: 1.25rem; object-fit: cover; box-shadow: 0 24px 70px rgba(0, 0, 0, 0.28); }
	.portrait p { width: 100%; margin: 1.15rem 0 0; color: var(--text); font-family: var(--font-display); font-size: 1.35rem; text-align: center; }
	.introduction h1 { font-family: var(--font-body); font-size: 1rem; font-weight: 400; line-height: 1.75; letter-spacing: 0; }
	.latest { padding: 4rem 0; }
	.paths { display: grid; padding: 4rem 0 2rem; grid-template-columns: 1fr 1fr; gap: 1rem; }
	.paths a { padding: 2rem; border: 1px solid var(--line); border-radius: 1rem; background: var(--surface); text-decoration: none; transition: border-color 160ms ease, transform 160ms ease; }
	.paths a:hover { border-color: rgba(213, 96, 66, 0.55); transform: translateY(-3px); }
	.paths span { color: var(--accent-soft); font-size: 0.75rem; letter-spacing: 0.12em; }
	.paths h2 { margin: 2.5rem 0 0.55rem; font-size: 2rem; }
	.paths p { margin: 0; color: var(--muted); font-size: 0.95rem; }
	@media (max-width: 760px) {
		.hero { min-height: auto; padding: 4rem 0; grid-template-columns: 1fr; gap: 2.75rem; }
		.portrait { width: min(100%, 200px); justify-self: center; }
		.paths { grid-template-columns: 1fr; }
	}
</style>
