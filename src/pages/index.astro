---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Avatar from '../assets/avatar.jpg';
import BaseHead from '../components/BaseHead.astro';
import ContributionCalendar from '../components/ContributionCalendar.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { GITHUB_URL, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const greeting = "Hi, I'm Asera";
const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="zh-CN">
	<head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /></head>
	<body>
		<Header />
		<main class="shell page-grid">
			<section class="home-profile card" aria-labelledby="home-greeting">
				<Image class="avatar" src={Avatar} alt="Asera" width={512} height={512} loading="eager" />
				<h1 id="home-greeting">
					<span class="sr-only">{greeting}</span>
					<span aria-hidden="true">{Array.from(greeting, (letter, index) => (
						<span class="greeting-letter" style={`--letter-delay: ${index * 45}ms`}>{letter}</span>
					))}</span>
				</h1>
				<div class="contacts">
					<a class="contact" href={GITHUB_URL} target="_blank" rel="noopener noreferrer">
						<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38l-.01-1.49c-2.23.49-2.7-.95-2.7-.95-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.81.06 1.23.83 1.23.83.71 1.23 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.96 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82A7.66 7.66 0 0 1 8 3.87c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.83 2.2-.83.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.08-1.87 3.76-3.65 3.96.29.25.54.74.54 1.48l-.01 2.19c0 .21.15.46.55.38A8 8 0 0 0 16 8c0-4.42-3.58-8-8-8Z" /></svg>
						<span>GitHub</span>
					</a>
					<a class="contact" href="mailto:aserawtz@gmail.com">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
						<span>Mail</span>
					</a>
				</div>
			</section>

			<div class="home-content">
				<section class="home-about card" aria-labelledby="home-about">
					<div class="section-heading"><h2 id="home-about">About</h2></div>
					<p>{SITE_DESCRIPTION}</p>
				</section>
				<ContributionCalendar />
				<section class="card" aria-labelledby="home-latest">
					<div class="section-heading">
						<h2 id="home-latest">Latest Writing</h2>
						<a class="text-link" href="/blog">All Writing →</a>
					</div>
					<ul class="post-list">
						{posts.map((post) => (
							<li class="post-item">
								<a href={`/blog/${post.id}/`}>
									<div><h3>{post.data.title}</h3><p>{post.data.description}</p></div>
									<FormattedDate date={post.data.pubDate} />
								</a>
							</li>
						))}
					</ul>
				</section>
			</div>
		</main>
	</body>
</html>

<style>
	.home-profile.card { display: grid; justify-items: center; gap: 1rem; border-color: transparent; background: none; text-align: center; }
	.avatar { width: min(100%, 8.5rem); aspect-ratio: 1; border: 1px solid var(--line); border-radius: 50%; object-fit: cover; }
	.home-profile h1 { font-size: 1.125rem; }
	.greeting-letter { display: inline-block; white-space: pre; }
	@media (prefers-reduced-motion: no-preference) {
		.greeting-letter { animation: greeting-hop 420ms ease-out var(--letter-delay) both; }
	}
	@keyframes greeting-hop {
		0% { opacity: 0; transform: translateY(0.55em); }
		55% { opacity: 1; transform: translateY(-0.18em); }
		100% { opacity: 1; transform: translateY(0); }
	}
	.contacts { display: grid; width: min(100%, 9rem); gap: 0.5rem; }
	.contact {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		min-height: 2.75rem;
		align-items: center;
		gap: 0.5rem;
		padding: 0.375rem 0.75rem;
		border: 1px solid var(--line);
		border-radius: 0.6rem;
		background: var(--surface-raised);
		color: var(--accent-soft);
		font: 1.0625rem/1.25 Consolas, monospace;
		text-decoration: none;
	}
	.contact svg { width: 1.25rem; height: 1.25rem; }
	.contact span { text-align: center; }
	.contact:hover { border-color: var(--accent); }
	.home-content { display: grid; gap: var(--layout-gap); }
	.home-about p { margin: 0; color: var(--muted); }
</style>
