---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';

const archiveDate = new Intl.DateTimeFormat('sv-SE', {
	timeZone: 'Asia/Shanghai',
	year: 'numeric',
	month: '2-digit',
	day: '2-digit',
});

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="zh-CN">
	<head><BaseHead title="Blog · Asera" description="Notes on research, technology, and ideas in progress." /></head>
	<body>
		<Header />
		<main class="shell page-grid blog-grid">
			<section class="archive" aria-labelledby="archive-title">
				<h1 id="archive-title">All Writing</h1>
				<ul class="post-list archive-list">
					{posts.map((post) => (
						<li>
							<a class="card archive-card" href={`/blog/${post.id}/`}>
								<h2>{post.data.title}</h2>
								<div class="archive-date">
									<span class="calendar-icon" aria-hidden="true">
										<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="5" width="16" height="16" rx="2" /><path d="M8 3v4m8-4v4M4 10h16" /></svg>
									</span>
									<time datetime={post.data.pubDate.toISOString()}><span class="sr-only">Created on </span>{archiveDate.format(post.data.pubDate)}</time>
								</div>
								<p>{post.data.description}</p>
							</a>
						</li>
					))}
				</ul>
			</section>
		</main>
	</body>
</html>

<style>
	.blog-grid { grid-template-columns: minmax(0, 1fr); }
	.archive h1 { margin: 0 0 1rem; font-size: 1.25rem; }
	.archive-list { display: grid; gap: var(--layout-gap); }
	.archive-card { display: grid; gap: 0.4rem; color: var(--text); text-decoration: none; }
	.archive-card:is(:hover, :focus-visible) { border-color: var(--accent); }
	.archive-card:is(:hover, :focus-visible) h2 { color: var(--accent-soft); }
	.archive-card h2 { font-size: clamp(1.1rem, 2vw, 1.4rem); overflow-wrap: anywhere; }
	.archive-card p { margin: 0; color: var(--muted); font-size: 0.95rem; }
	.archive-date { display: flex; align-items: center; gap: 0.55rem; color: var(--muted); font-size: 0.875rem; font-variant-numeric: tabular-nums; }
	.calendar-icon { display: grid; width: 1.75rem; height: 1.75rem; place-items: center; border-radius: 0.45rem; background: var(--surface-raised); color: var(--accent-soft); }
</style>
