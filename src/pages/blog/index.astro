---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="zh-CN">
	<head><BaseHead title="Blog · Asera" description="Notes on research, technology, and ideas in progress." /></head>
	<body>
		<Header />
		<main class="shell">
			<section class="archive" aria-label="Blog archive">
				<div class="section-heading"><h2>All writing</h2></div>
				<ul class="post-list">
					{posts.map((post) => (
						<li class="post-item">
							<a href={`/blog/${post.id}/`}>
								<div><h3>{post.data.title}</h3><p>{post.data.description}</p></div>
								<time datetime={post.data.pubDate.toISOString()}><FormattedDate date={post.data.pubDate} /></time>
							</a>
						</li>
					))}
				</ul>
			</section>
		</main>
	</body>
</html>

<style>.archive { padding: 6rem 0 5rem; }</style>
